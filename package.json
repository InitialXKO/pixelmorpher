{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "build:sam-worker": "esbuild scripts/sam-worker-entry.js --bundle --format=esm --target=esnext --outfile=public/sam-worker/worker.bundle.js --define:process.env.NODE_ENV='\"production\"' --log-level=info",
    "copy:ort-wasm": "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm public/ort-wasm/ && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm public/ort-wasm/ && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs public/ort-wasm/ && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs public/ort-wasm/",
    "postinstall": "echo skip-polarfs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "zustand": "^5.0.6",
    "gif.js": "^0.2.0",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^3.0.3",
    "sam-web": "^0.3.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
